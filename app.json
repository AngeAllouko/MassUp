{
  "expo": {
    "name": "MassUp",
    "slug": "massup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#05090B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.massup.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05090B"
      },
      "package": "com.massup.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#2DE2D0"
        }
      ],
      "expo-sharing",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "96120485-e6bd-4ca9-9eff-1cfbf56ce442"
      }
    }
  }
}
